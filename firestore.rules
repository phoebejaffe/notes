rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/metadata/keyBundle {
      allow read, write: if signedInAs(userId);
    }

    match /users/{userId}/documents/{day} {
      allow read: if signedInAs(userId);
      allow create, update, delete: if signedInAs(userId)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
