{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main, capture, and todo windows",
  "windows": [
    "main",
    "todo"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "shell:allow-open",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
